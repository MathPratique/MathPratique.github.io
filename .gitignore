# Configuration locale. `.env.example` est versionné, les vrais fichiers non.
# Les clés Firebase du client ne sont pas des secrets, mais un fichier .env
# finit toujours par accueillir autre chose : clé de service, jeton Stripe.
.env
.env.*
!.env.example

# Clés de compte de service Firebase — ne doivent jamais être versionnées.
*-firebase-adminsdk-*.json
serviceAccountKey.json
