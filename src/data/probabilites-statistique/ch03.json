          "texte": "Un échantillon de $n = 100$ donne $\\bar{x} = 105$ et $s = 20$. On teste $H_0 : \\mu = 100$ vs $H_1 : \\mu \\neq 100$. Calcule la statistique de test $z$."
        },
        {
          "etape": "reponse",
          "titre": "Réponse finale",
          "texte": "$z = 2{,}5$."
        },
        {
          "etape": "demarche",
          "titre": "Démarche détaillée",
          "lignes": [
            "$z = (\\bar{x} - \\mu_0)/(s/\\sqrt{n}) = (105 - 100)/(20/\\sqrt{100}) = 5/2 = 2{,}5$."
          ]
        }
      ]
