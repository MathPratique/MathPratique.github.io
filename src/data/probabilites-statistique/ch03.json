          "etape": "reponse",
          "titre": "Réponse finale",
          "texte": "2,00"
        },
        {
          "etape": "demarche",
          "titre": "Démarche détaillée",
          "lignes": [
            "$z = (\\bar{x} - \\mu_0)/(s/\\sqrt{n}) = (52 - 50)/(8/\\sqrt{64}) = 2/1 = 2$.",
