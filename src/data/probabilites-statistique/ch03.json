        },
        {
          "etape": "reponse",
          "titre": "Réponse finale",
          "texte": "$z \\approx 2{,}14$ ; rejeter $H_0$. Taux réel significativement supérieur à 2 %."
        },
        {
          "etape": "demarche",
          "titre": "Démarche détaillée",
          "lignes": [
            "$H_0 : p = 0{,}02$ ; $H_1 : p > 0{,}02$.",
            "Conditions : $np_0 = 8 \\geq 5$ ✓ ; $n(1 - p_0) = 392 \\geq 5$ ✓.",
            "$\\hat{p} = 14/400 = 0{,}035$.",
            "$z = (0{,}035 - 0{,}02)/\\sqrt{0{,}02 \\times 0{,}98/400} = 0{,}015/0{,}007 \\approx 2{,}14$.",
            "$z_{0{,}05} = 1{,}645$.",
            "$2{,}14 > 1{,}645$ → rejeter $H_0$."
          ]
        }
      ]
