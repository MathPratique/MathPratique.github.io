          "etape": "enonce",
          "titre": "Énoncé",
          "texte": "On teste $H_0 : \\mu = 50$ vs $H_1 : \\mu \\neq 50$ avec $n = 64$, $\\bar{x} = 52$, $s = 8$. Quelle est la statistique $z$ observée ?",
          "choix": [
            {
              "cle": "a",
              "texte": "0,25"
            },
            {
              "cle": "b",
              "texte": "2,00"
            },
            {
              "cle": "c",
              "texte": "4,00"
            },
            {
              "cle": "d",
              "texte": "16,00"
            }
