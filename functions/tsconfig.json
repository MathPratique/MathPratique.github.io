{
  // Les fonctions réutilisent la règle d'accès du site plutôt que d'en garder
  // une copie : `rootDir` remonte d'un cran pour englober `../src/acces`, et
  // la sortie se retrouve donc dans `lib/functions/` et `lib/src/`. C'est le
  // prix à payer pour qu'il n'existe QU'UNE seule définition de « 12 mois »
  // dans tout le projet. Deux copies finiraient par diverger, et la
  // divergence porterait sur la date d'expiration d'un accès payant.
  "compilerOptions": {
    // `nodenext` : matche la runtime déclarée dans firebase.json
    // (`"runtime": "nodejs20"`) et débloque les import attributes
    // (`import x from "./f.json" with { type: "json" }`) pour importer
    // le blob des 305 exos dans obtenirExercices.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Nécessaire pour que TypeScript accepte les imports de .json ET
    // les copie de src/ vers lib/ au build — sans quoi la banque
    // manquerait à l'exécution de la Function.
    "resolveJsonModule": true,
    "target": "ES2022",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "..",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": ["src/**/*.ts", "../src/acces/**/*.ts"]
}
