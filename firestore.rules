rules_version = '2';

// ===========================================================================
//  Règles de sécurité Firestore
// ===========================================================================
//
//  Principe directeur : le client LIT ses propres accès, il n'en ÉCRIT
//  jamais. Toute écriture d'accès passe par le webhook Stripe, qui utilise le
//  SDK Admin et contourne ces règles. Si le navigateur pouvait écrire ici,
//  n'importe qui s'accorderait douze mois gratuits depuis la console du
//  navigateur — c'est le premier endroit qu'un curieux essaie.
//
//  Déploiement :
//      firebase deploy --only firestore:rules
//
//  Test des règles (émulateur, sans toucher à la production) :
//      firebase emulators:start --only firestore
//
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Par défaut, tout est refusé ---------------------------------------
    // Les règles qui suivent n'ouvrent que ce qui est nécessaire. Toute
    // collection non mentionnée reste inaccessible depuis le navigateur.
    match /{document=**} {
      allow read, write: if false;
    }

    function estLeProprietaire(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // --- Profil utilisateur ------------------------------------------------
    match /utilisateurs/{uid} {
      allow read: if estLeProprietaire(uid);

      // L'utilisateur peut créer et modifier son profil, mais uniquement des
      // champs anodins. La liste est blanche, pas noire : un champ inconnu
      // fait échouer l'écriture au lieu de passer par défaut.
      allow create, update: if estLeProprietaire(uid)
        && request.resource.data.keys().hasOnly(['courriel', 'nomAffiche', 'creeLe']);

      allow delete: if false;

      // --- Accès à un cours ------------------------------------------------
      match /acces/{coursId} {
        // Lecture seule, et seulement les siens. Personne ne consulte les
        // achats de quelqu'un d'autre.
        allow read: if estLeProprietaire(uid);

        // Aucune écriture depuis le navigateur, sans exception. Ni création
        // (s'accorder un accès), ni mise à jour (repousser dateFin), ni
        // suppression (effacer aTelecharge pour redevenir remboursable).
        //
        // Le webhook Stripe et la fonction de téléchargement écrivent avec le
        // SDK Admin, qui n'est pas soumis à ces règles.
        allow write: if false;
      }

      // --- Progression personnelle ----------------------------------------
      // Un document par cours, réservé aux détenteurs d'un accès valide.
      // Contient les exercices complétés et marqués, sous forme de deux
      // dictionnaires plats {idExo: timestamp}. La règle d'accès valide est
      // la MÊME que celle du téléchargement : `dateFin > request.time`,
      // horloge du serveur Firestore. Un accès expiré rend la progression
      // inaccessible SANS la supprimer — l'étudiant retrouve son historique
      // s'il rachète.
      match /progression/{coursId} {
        function accesValide() {
          let doc = /databases/$(database)/documents/utilisateurs/$(uid)/acces/$(coursId);
          return exists(doc) && get(doc).data.dateFin > request.time;
        }
        // Liste blanche des clés autorisées : empêche un client bavard de
        // gonfler le document avec des champs inconnus. Le format des
        // valeurs (timestamps dans completes/marques) n'est pas audité —
        // du contenu bidon ne pollue que le propre affichage du fauteur.
        function formeValide() {
          return request.resource.data.keys().hasOnly(
            ['completes', 'marques', 'dateMaj', 'version']
          );
        }
        allow read:   if estLeProprietaire(uid) && accesValide();
        allow create: if estLeProprietaire(uid) && accesValide() && formeValide();
        allow update: if estLeProprietaire(uid) && accesValide() && formeValide();
        // Jamais de delete : l'expiration ne doit pas effacer, pour que le
        // rachat restaure l'historique intact.
        allow delete: if false;
      }
    }

    // --- Compte administrateur du site --------------------------------------
    // Un seul compte, désigné par son uid. Un uid n'est pas un secret : il ne
    // permet pas de se connecter. Le même uid est écrit dans
    // src/devoirs/regles.ts (UID_ADMINISTRATEUR), qui ne sert qu'à afficher
    // ou cacher le bouton d'édition ; un test vérifie que les deux valeurs
    // sont identiques. Changer d'administrateur = modifier les deux, puis
    // déployer ces règles.
    function estAdministrateurSite() {
      return request.auth != null && request.auth.uid == "hZWPVvkJcWTmRbpox6jr0X6Mz3P2";
    }

    // --- Devoirs d'un cours ------------------------------------------------
    // Un document par cours : la liste des exercices à faire, par semaine,
    // désignés par leur ID dans la banque. Lu par les étudiants du cours
    // (niveau restreint, accès valide), écrit par l'administrateur seulement.
    match /devoirs/{coursId} {
      // Même lecture du niveau que `niveauDe` dans le site : absent, vide ou
      // inconnu compte comme « restreint ». Seuls « acheteur » et
      // « enseignant » sont exclus — les devoirs sont ceux d'un groupe-classe.
      function etudiantDuCours() {
        let a = /databases/$(database)/documents/utilisateurs/$(request.auth.uid)/acces/$(coursId);
        return request.auth != null
          && exists(a)
          && get(a).data.dateFin > request.time
          && !(get(a).data.get('niveau', 'restreint') in ['acheteur', 'enseignant']);
      }
      // Liste blanche des clés, comme pour la progression. Le contenu de
      // chaque semaine n'est pas audité ici : seul l'administrateur écrit.
      function formeValide() {
        return coursId in ['calcul-differentiel']
          && request.resource.data.keys().hasOnly(['semaines', 'version', 'dateMaj'])
          && request.resource.data.semaines is list
          && request.resource.data.semaines.size() <= 60
          && request.resource.data.version is int
          && request.resource.data.dateMaj == request.time;
      }
      allow read: if estAdministrateurSite() || etudiantDuCours();
      // `version` sert de verrou : un enregistrement fait à partir d'une
      // version périmée (deux onglets ouverts) est refusé au lieu d'écraser
      // le plus récent.
      allow create: if estAdministrateurSite() && formeValide()
        && request.resource.data.version == 1;
      allow update: if estAdministrateurSite() && formeValide()
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }

    // --- Journal des événements Stripe -------------------------------------
    // Sert à l'idempotence du webhook : un identifiant de session déjà
    // présent signifie « déjà traité ». Écrit et lu par le serveur seulement ;
    // le navigateur n'a aucune raison d'y toucher.
    match /evenementsStripe/{sessionId} {
      allow read, write: if false;
    }
  }
}
